1. Заполнить id_regional_energy_system из энергоузлов
UPDATE generation.stations sSET id_regional_energy_system = eu.id_regional_energy_systemFROM gs_sys.gs_energy_units euWHERE s.id_energy_unit IS NOT NULL  AND s.id_energy_unit <> 0  AND s.id_energy_unit = eu.id  AND s.database_version_id = 7          -- нужная версия БД  AND eu.database_version_id = 7  AND (s.id_regional_energy_system IS NULL OR s.id_regional_energy_system = 0);
2. Для станций без энергоузла — через связь «субъект РФ ↔ РЭС»
UPDATE generation.stations sSET id_regional_energy_system = sub.res_idFROM (    SELECT        rdres.regional_district_id AS rd_id,        MIN(            CASE                WHEN rdres.regional_energy_system_id > 0                THEN rdres.regional_energy_system_id            END        ) AS res_id    FROM gs_sys.gs_regional_district_regional_energy_system rdres    JOIN gs_sys.gs_regional_districts rd      ON rd.id = rdres.regional_district_id    WHERE rd.database_version_id = 7     -- та же версия БД    GROUP BY rdres.regional_district_id) subWHERE (s.id_energy_unit IS NULL OR s.id_energy_unit = 0)  AND s.id_regional_district = sub.rd_id  AND s.database_version_id = 7  AND (s.id_regional_energy_system IS NULL OR s.id_regional_energy_system = 0)  AND sub.res_id IS NOT NULL;
После выполнения можно проверить:
SELECT id_regional_energy_system, COUNT(*)FROM generation.stationsWHERE database_version_id = 7GROUP BY id_regional_energy_systemORDER BY id_regional_energy_system;

