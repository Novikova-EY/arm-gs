#!/bin/bash
set -euo pipefail

APP_USER="generation-app"
APP_GROUP="${APP_USER}"
APP_HOME="/opt/generation-app"
APP_SRC="${APP_HOME}/app"
VENV_PATH="${APP_HOME}/venv"
ENV_DIR="/etc/generation-app"
ENV_FILE="${ENV_DIR}/app.env"
ENV_TEMPLATE="/usr/share/generation-app/app.env.example"
SYSTEMD_UNIT="generation-app.service"
PYTHON_BIN=${PYTHON_BIN:-python3}

create_user() {
    if ! id -u "${APP_USER}" >/dev/null 2>&1; then
        adduser \
            --system \
            --group \
            --home "${APP_HOME}" \
            --no-create-home \
            "${APP_USER}"
    fi
}

create_dirs() {
    install -d -o "${APP_USER}" -g "${APP_GROUP}" -m 750 "${APP_HOME}"
    install -d -o "${APP_USER}" -g "${APP_GROUP}" -m 750 "${APP_HOME}/logs"
    install -d -o root -g "${APP_GROUP}" -m 750 "${ENV_DIR}"
}

adjust_permissions() {
    chown -R "${APP_USER}:${APP_GROUP}" "${APP_HOME}"
}

setup_env_file() {
    if [ ! -f "${ENV_FILE}" ] && [ -f "${ENV_TEMPLATE}" ]; then
        install -m 640 "${ENV_TEMPLATE}" "${ENV_FILE}"
        chown root:"${APP_GROUP}" "${ENV_FILE}"
    fi
}

create_venv() {
    if [ ! -d "${VENV_PATH}" ]; then
        "${PYTHON_BIN}" -m venv "${VENV_PATH}"
    fi
    "${VENV_PATH}/bin/pip" install --upgrade pip setuptools wheel
    "${VENV_PATH}/bin/pip" install -r "${APP_SRC}/requirements-linux.txt"
}

reload_systemd() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload
        systemctl enable "${SYSTEMD_UNIT}" >/dev/null 2>&1 || true
    fi
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/generation-app.conf >/dev/null 2>&1 || true
    fi
}

case "${1}" in
    configure)
        create_user
        create_dirs
        adjust_permissions
        setup_env_file
        create_venv
        reload_systemd
        ;;
esac

exit 0

