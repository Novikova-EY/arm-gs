#!/bin/bash
set -e

SERVICE="generation-app.service"

case "$1" in
    remove|upgrade|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop "$SERVICE" >/dev/null 2>&1 || true
            if [ "$1" = "remove" ]; then
                systemctl disable "$SERVICE" >/dev/null 2>&1 || true
            fi
        fi
        ;;
esac

exit 0





