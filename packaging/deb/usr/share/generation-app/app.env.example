# Базовые переменные окружения для сервера Astra Linux

# ----- Flask / Secret -----
FLASK_ENV=production
SECRET_KEY=change-me

# ----- Database (PostgreSQL) -----
# Примечание: DB_PASS и DB_PASSWORD можно изменить в /etc/generation-app/app.env после установки
DB_USER=postgres
DB_PASS=123
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=arm_generation
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_SEARCH_PATH=auth,logs,refdata,generation,public

# ----- Redis -----
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=${REDIS_URL}

# ----- Gunicorn -----
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=gevent
GUNICORN_THREADS=4

# ----- Paths -----
UPLOAD_FOLDER=/opt/generation-app/app/uploads
AUTO_BACKUP_DIR=/opt/generation-app/app/backups/auto




