# ==========================================
# Конфигурация для параллельной работы
# ==========================================

# ==========================================
# Database Configuration
# ==========================================
DB_USER=generation
DB_PASS=R7fP9wQk
DB_PASSWORD=R7fP9wQk
DB_HOST=localhost
# DB_HOST=10.31.205.27
DB_PORT=5432
DB_NAME=gs_gen
DB_DRIVER=psycopg2

# Схемы БД
SCHEMA_AUTH=auth
SCHEMA_LOGS=logs
SCHEMA_REFDATA=gs_sys
SCHEMA_GENERATION=generation
DB_SEARCH_PATH=auth,logs,gs_sys,generation,public

# ==========================================
# Database Connection Pool Settings
# Настройки для оптимизации параллельной работы
# ==========================================

# Базовый размер пула соединений
# Рекомендация: 10-20 для малой нагрузки, 20-40 для средней, 40+ для высокой
SQLALCHEMY_POOL_SIZE=20

# Дополнительные соединения при пиковой нагрузке
# Рекомендация: в 2 раза больше чем POOL_SIZE
SQLALCHEMY_MAX_OVERFLOW=40

# Таймаут ожидания свободного соединения (секунды)
SQLALCHEMY_POOL_TIMEOUT=30

# Время жизни соединения перед переиспользованием (секунды)
# Важно: должно быть меньше wait_timeout MySQL/PostgreSQL
SQLALCHEMY_POOL_RECYCLE=280

# Проверка соединения перед использованием (True/False)
SQLALCHEMY_POOL_PRE_PING=True

# Логирование пула соединений (для отладки, True/False)
SQLALCHEMY_ECHO_POOL=False

# ==========================================
# Redis Configuration
# Для кэширования и хранения сессий
# ==========================================

# URL подключения к Redis
# Формат: redis://[password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Тип кэша (RedisCache или SimpleCache для fallback)
CACHE_TYPE=RedisCache

# URL для кэша (может отличаться от основного Redis)
CACHE_REDIS_URL=redis://localhost:6379/0

# Время жизни кэша по умолчанию (секунды)
CACHE_DEFAULT_TIMEOUT=300

# ==========================================
# Gunicorn Configuration (Linux/Mac)
# Настройки production WSGI сервера
# ==========================================

# Адрес привязки (host:port)
GUNICORN_BIND=0.0.0.0:8000

# Количество worker процессов
# Рекомендация: (CPU cores * 2) + 1
# Для 4 cores: 9, для 8 cores: 17
GUNICORN_WORKERS=9

# Класс worker'а
# gevent - для асинхронной обработки (рекомендуется)
# sync - для синхронной обработки
# gthread - для многопоточной обработки
GUNICORN_WORKER_CLASS=gevent

# Количество потоков на worker (только для sync/gthread)
GUNICORN_THREADS=4

# Максимальное количество одновременных соединений на worker (для gevent)
GUNICORN_WORKER_CONNECTIONS=1000

# Таймаут запроса (секунды). Для импорта больших Excel-файлов нужно 600+ (см. docs/deployment/ASTRA_INSTALL.md)
GUNICORN_TIMEOUT=600

# Graceful timeout при завершении worker'а (секунды)
GUNICORN_GRACEFUL_TIMEOUT=30

# Keep-alive соединений (секунды)
GUNICORN_KEEPALIVE=5

# Максимальное количество запросов на worker перед перезапуском
# Предотвращает утечки памяти
GUNICORN_MAX_REQUESTS=10000

# Разброс для MAX_REQUESTS (для избежания одновременного перезапуска workers)
GUNICORN_MAX_REQUESTS_JITTER=1000

# Уровень логирования (debug, info, warning, error, critical)
GUNICORN_LOG_LEVEL=info

# Путь к файлу access log (- для stdout)
GUNICORN_ACCESS_LOG=-

# Путь к файлу error log (- для stderr)
GUNICORN_ERROR_LOG=-

# ==========================================
# Waitress Configuration (Windows)
# Настройки production WSGI сервера для Windows
# ==========================================

# Адрес привязки
WAITRESS_HOST=0.0.0.0
WAITRESS_PORT=8000

# Количество потоков
# Рекомендация: (CPU cores * 2)
# Для 4 cores: 8, для 8 cores: 16
WAITRESS_THREADS=16

# Максимальное количество одновременных соединений
WAITRESS_CONNECTION_LIMIT=1000

# Размер буфера для входящих запросов (байты)
WAITRESS_RECV_BYTES=65536

# Размер буфера для исходящих ответов (байты)
WAITRESS_SEND_BYTES=65536

# Таймаут канала (секунды)
WAITRESS_CHANNEL_TIMEOUT=120

# Интервал очистки (секунды)
WAITRESS_CLEANUP_INTERVAL=30

# URL scheme
WAITRESS_URL_SCHEME=http

# Expose tracebacks (только для development, True/False)
WAITRESS_EXPOSE_TRACEBACKS=False

# ==========================================
# Application Settings
# ==========================================

# Режим отладки (True/False)
# ВАЖНО: Должен быть False в production!
DEBUG=True
FLASK_ENV=development

# Секретный ключ приложения
# ВАЖНО: Используйте надежный случайный ключ в production!
SECRET_KEY='defe703aa978d73207801789a0aae2e3d33807c1866b9317fb983bfd56c42d72'

# URI базы данных (альтернативный способ настройки)
# Формат: postgresql+psycopg2://user:password@host:port/dbname
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://user:pass@localhost:5432/dbname

# Папка для загрузки файлов
UPLOAD_FOLDER=uploads

# Разрешенные расширения файлов для загрузки
ALLOWED_EXTENSIONS=xls,xlsx,pdf,doc,docx

# Годы для планирования
START_YEAR=2024
END_YEAR=2031
START_YEAR_SIPR=2026
END_YEAR_SIPR=2031

# ==========================================
# Настройка для формирования бэкапов базы данных
# ==========================================

ENABLE_SCHEDULED_BACKUPS=True
AUTO_BACKUP_DIR=backups/auto
KEEP_AUTO_BACKUPS=7
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0

# ==========================================
# Примеры конфигурации для разных нагрузок
# ==========================================

# --- Малая нагрузка (до 50 пользователей) ---
# GUNICORN_WORKERS=5
# GUNICORN_WORKER_CONNECTIONS=500
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_MAX_OVERFLOW=20

# --- Средняя нагрузка (50-200 пользователей) ---
# GUNICORN_WORKERS=9
# GUNICORN_WORKER_CONNECTIONS=1000
# SQLALCHEMY_POOL_SIZE=20
# SQLALCHEMY_MAX_OVERFLOW=40

# ==========================================
# Дополнительные настройки (опционально)
# ==========================================

# Timezone
TZ=Europe/Moscow

# Максимальный размер загружаемого файла (байты)
# MAX_CONTENT_LENGTH=16777216  # 16 MB

# Включение compression для ответов
# COMPRESS_MIMETYPES=text/html,text/css,text/xml,application/json,application/javascript

# Session configuration
# SESSION_COOKIE_SECURE=True  # Только для HTTPS
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=Lax

